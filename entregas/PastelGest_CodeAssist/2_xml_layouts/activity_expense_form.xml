<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pg_bg"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/PG.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/form_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true"
            android:orientation="vertical"
            android:padding="@dimen/pg_gutter">
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ef_category_layout"
                        style="@style/PG.Input.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/f_category">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/ef_category"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ef_description_layout"
                        style="@style/PG.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/f_description">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ef_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textCapSentences"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ef_amount_layout"
                        style="@style/PG.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/f_amount"
                        app:suffixText="Kz">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ef_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ef_date_layout"
                        style="@style/PG.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/f_date">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ef_date"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:maxLines="1"
                            android:focusable="false"
                            android:clickable="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ef_method_layout"
                        style="@style/PG.Input.Dropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/f_payment_method">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/ef_method"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/ef_fixed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/f_fixed_expense"
                        android:textColor="@color/pg_text" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        style="@style/PG.Text.Section"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        android:text="@string/s_receipt" />
                    <TextView
                        android:id="@+id/ef_receipt_status"
                        style="@style/PG.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/receipt_none" />
                    <ImageView
                        android:id="@+id/ef_receipt_image"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginVertical="8dp"
                        android:background="@drawable/bg_photo"
                        android:contentDescription="@string/s_receipt"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ef_receipt_pick"
                        style="@style/PG.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/action_attach_receipt"
                        app:icon="@drawable/ic_image" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/ef_receipt_remove"
                        style="@style/PG.Button.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/action_remove_receipt"
                        app:icon="@drawable/ic_delete" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pg_nav_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_save"
            style="@style/PG.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_save" />
    </LinearLayout>
</LinearLayout>
