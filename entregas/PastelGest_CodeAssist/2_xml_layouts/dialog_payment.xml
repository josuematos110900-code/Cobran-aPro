<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">
        <TextView
            android:id="@+id/dp_info"
            style="@style/PG.Text.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dp_amount_layout"
            style="@style/PG.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_amount"
            app:suffixText="Kz">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dp_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dp_method_layout"
            style="@style/PG.Input.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_payment_method">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dp_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dp_note_layout"
            style="@style/PG.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dp_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
