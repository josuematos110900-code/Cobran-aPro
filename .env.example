# Copie este ficheiro para ".env.local" e preencha com os valores do seu
# projecto Supabase (Project Settings > API).
#
# NUNCA coloque aqui a SERVICE_ROLE_KEY. Esta aplicação só deve usar
# a URL do projecto e a chave "anon" (pública), que é segura para o
# frontend porque toda a protecção de dados é feita via Row Level Security.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY_PUBLICA

# Opcional. Número de WhatsApp (formato internacional, só dígitos, ex:
# 244923000000) para onde a página /billing envia o pedido de upgrade de
# plano, já que não existe gateway de pagamento com API/webhook para
# Angola nesta versão — ver README, secção "Planos e assinatura".
VITE_SALES_WHATSAPP_NUMBER=
