<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp">
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ds_product_layout"
            style="@style/PG.Input.Dropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_product">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/ds_product"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/ds_stock"
            style="@style/PG.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ds_qty_layout"
            style="@style/PG.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_quantity"
            app:suffixText="un">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ds_qty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ds_price_layout"
            style="@style/PG.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_unit_price_sale"
            app:suffixText="Kz">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ds_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/ds_discount_layout"
            style="@style/PG.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/f_line_discount"
            app:suffixText="Kz">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/ds_discount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView
            android:id="@+id/ds_preview"
            style="@style/PG.Text.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
